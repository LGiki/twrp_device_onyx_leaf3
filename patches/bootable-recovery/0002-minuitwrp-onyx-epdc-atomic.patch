@@ -475,7 +647,22 @@ static GRSurface* drm_init(minui_backend* backend __unused) {
 
     current_buffer = 0;
 
-    drm_enable_crtc(drm_fd, main_monitor_crtc, drm_surfaces[1]);
+    printf("ONYX EPDC: waiting 4 seconds for waveform initialization\n");
+    sleep(4);
