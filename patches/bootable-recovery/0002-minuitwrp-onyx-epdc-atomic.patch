 static int drm_fd = -1;
 
+/*
+ * ONYX's EPDC driver does not support the legacy drmModeSetCrtc/page-flip
+ * path. It exposes a split-plane atomic pipeline plus two private properties
+ * used to submit an mxcfb-style update description.
+ */
+struct onyx_epdc_update {
+    uint32_t top;
+    uint32_t left;
+    uint32_t width;
+    uint32_t height;
+    uint32_t waveform_mode;
+    uint32_t update_mode;
+    uint32_t update_marker;
+    int32_t temperature;
+    uint32_t flags;
+};
+
+static uint32_t main_crtc_index;
+static uint32_t epdc_plane_ids[2];
+static size_t epdc_plane_count;
+static uint32_t mode_blob_id;
+static uint32_t update_marker;
+static struct onyx_epdc_update epdc_update;
+
+static uint32_t drm_get_property_id(uint32_t object_id,
+                                    uint32_t object_type,
+                                    const char* name) {
+    drmModeObjectProperties* props =
+            drmModeObjectGetProperties(drm_fd, object_id, object_type);
+    if (!props)
+        return 0;
+
+    uint32_t id = 0;
+    for (uint32_t i = 0; i < props->count_props; ++i) {
+        drmModePropertyRes* prop = drmModeGetProperty(drm_fd, props->props[i]);
+        if (prop) {
+            if (!strcmp(prop->name, name))
+                id = prop->prop_id;
+            drmModeFreeProperty(prop);
+        }
+        if (id)
+            break;
+    }
+    drmModeFreeObjectProperties(props);
+    return id;
+}
+
+static bool drm_atomic_add(drmModeAtomicReq* req,
+                           uint32_t object_id,
+                           uint32_t object_type,
+                           const char* name,
+                           uint64_t value) {
+    uint32_t prop_id = drm_get_property_id(object_id, object_type, name);
+    if (!prop_id) {
+        printf("Missing DRM property %s on object %u\n", name, object_id);
+        return false;
+    }
+    if (drmModeAtomicAddProperty(req, object_id, prop_id, value) < 0) {
+        printf("Failed to add DRM property %s on object %u\n", name, object_id);
+        return false;
+    }
+    return true;
+}
+
+static bool drm_find_epdc_planes() {
+    drmModePlaneRes* plane_res = drmModeGetPlaneResources(drm_fd);
+    if (!plane_res)
+        return false;
+
+    epdc_plane_count = 0;
+    /* Plane zero belongs to the bootloader continuous-splash handoff. */
+    for (uint32_t i = 1; i < plane_res->count_planes && epdc_plane_count < 2; ++i) {
+        drmModePlane* plane = drmModeGetPlane(drm_fd, plane_res->planes[i]);
+        if (plane) {
+            if (plane->possible_crtcs & (1U << main_crtc_index))
+                epdc_plane_ids[epdc_plane_count++] = plane->plane_id;
+            drmModeFreePlane(plane);
+        }
+    }
+    drmModeFreePlaneResources(plane_res);
+    printf("ONYX EPDC: selected %zu atomic planes: %u,%u\n",
+           epdc_plane_count, epdc_plane_ids[0], epdc_plane_ids[1]);
+    return epdc_plane_count != 0;
+}
+
+static int drm_epdc_commit(struct drm_surface* surface, bool modeset) {
+    drmModeAtomicReq* req = drmModeAtomicAlloc();
+    if (!req)
+        return -ENOMEM;
+
+    bool ok = true;
+    const uint32_t width = surface->base.width;
+    const uint32_t height = surface->base.height;
+
+    if (modeset) {
+        ok &= drm_atomic_add(req, main_monitor_connector->connector_id,
+                             DRM_MODE_OBJECT_CONNECTOR, "CRTC_ID",
+                             main_monitor_crtc->crtc_id);
+        ok &= drm_atomic_add(req, main_monitor_crtc->crtc_id,
+                             DRM_MODE_OBJECT_CRTC, "MODE_ID", mode_blob_id);
+        ok &= drm_atomic_add(req, main_monitor_crtc->crtc_id,
+                             DRM_MODE_OBJECT_CRTC, "ACTIVE", 1);
+    }
+
+    for (size_t i = 0; i < epdc_plane_count; ++i) {
+        uint32_t x = (width * i) / epdc_plane_count;
+        uint32_t next_x = (width * (i + 1)) / epdc_plane_count;
+        uint32_t slice_width = next_x - x;
+        uint32_t plane = epdc_plane_ids[i];
+
+        ok &= drm_atomic_add(req, plane, DRM_MODE_OBJECT_PLANE,
+                             "FB_ID", surface->fb_id);
+        if (modeset) {
+            ok &= drm_atomic_add(req, plane, DRM_MODE_OBJECT_PLANE,
+                                 "CRTC_ID", main_monitor_crtc->crtc_id);
+            ok &= drm_atomic_add(req, plane, DRM_MODE_OBJECT_PLANE,
+                                 "SRC_X", (uint64_t)x << 16);
+            ok &= drm_atomic_add(req, plane, DRM_MODE_OBJECT_PLANE,
+                                 "SRC_Y", 0);
+            ok &= drm_atomic_add(req, plane, DRM_MODE_OBJECT_PLANE,
+                                 "SRC_W", (uint64_t)slice_width << 16);
+            ok &= drm_atomic_add(req, plane, DRM_MODE_OBJECT_PLANE,
+                                 "SRC_H", (uint64_t)height << 16);
+            ok &= drm_atomic_add(req, plane, DRM_MODE_OBJECT_PLANE,
+                                 "CRTC_X", x);
+            ok &= drm_atomic_add(req, plane, DRM_MODE_OBJECT_PLANE,
+                                 "CRTC_Y", 0);
+            ok &= drm_atomic_add(req, plane, DRM_MODE_OBJECT_PLANE,
+                                 "CRTC_W", slice_width);
+            ok &= drm_atomic_add(req, plane, DRM_MODE_OBJECT_PLANE,
+                                 "CRTC_H", height);
+        }
+    }
+
+    if (!modeset) {
+        epdc_update.top = 0;
+        epdc_update.left = 0;
+        epdc_update.width = width;
+        epdc_update.height = height;
+        epdc_update.waveform_mode = 2;
+        epdc_update.update_mode = 0;
+        epdc_update.update_marker = update_marker++;
+        epdc_update.temperature = 24;
+        epdc_update.flags = 0;
+
+        ok &= drm_atomic_add(req, epdc_plane_ids[0], DRM_MODE_OBJECT_PLANE,
+                             "EPDC_UPDATE_CNT", 1);
+        ok &= drm_atomic_add(req, epdc_plane_ids[0], DRM_MODE_OBJECT_PLANE,
+                             "EPDC_UPDATE_PARMS_ADDR",
+                             reinterpret_cast<uintptr_t>(&epdc_update));
+    }
+
+    printf("ONYX EPDC commit: modeset=%d fb=%u planes=%u,%u marker=%u\n",
+           modeset, surface->fb_id, epdc_plane_ids[0], epdc_plane_ids[1], update_marker);
+    int ret = ok ? drmModeAtomicCommit(drm_fd, req,
+                                       DRM_MODE_ATOMIC_ALLOW_MODESET, NULL)
+                 : -EINVAL;
+    drmModeAtomicFree(req);
+    printf("ONYX EPDC commit result=%d\n", ret);
+    return ret;
+}
+
