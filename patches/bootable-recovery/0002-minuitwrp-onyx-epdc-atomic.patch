+    memcpy(drm_surfaces[1]->base.data, draw_buf->data,
+           draw_buf->height * draw_buf->row_bytes);
+    drm_epdc_commit(drm_surfaces[1], true);
 
     return draw_buf;
 }
@@ -486,11 +669,10 @@ static GRSurface* drm_flip(minui_backend* backend __unused) {
             draw_buf->data, draw_buf->height * draw_buf->row_bytes);
 
 
-    ret = drmModePageFlip(drm_fd, main_monitor_crtc->crtc_id,
-                          drm_surfaces[current_buffer]->fb_id, 0, NULL);
+    ret = drm_epdc_commit(drm_surfaces[current_buffer], false);
     if (ret < 0) {
-        printf("drmModePageFlip failed ret=%d\n", ret);
-        return NULL;
