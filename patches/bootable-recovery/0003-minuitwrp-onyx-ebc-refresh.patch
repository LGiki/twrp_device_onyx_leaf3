+static bool onyx_ebc_init(uint32_t width, uint32_t height) {
+    struct onyx_ebc_buffer_info info = {};
+
+    ebc_fd = open("/dev/ebc", O_RDWR);
+    if (ebc_fd < 0) {
+        perror("ONYX EBC: open /dev/ebc failed");
+        return false;
+    }
+
+    int info_size = ioctl(ebc_fd, ONYX_EBC_GET_BUFFER_INFO, nullptr);
+    if (info_size != 0 && info_size != (int)sizeof(info)) {
+        printf("ONYX EBC: unexpected buffer-info size %d (expected %zu)\n",
+               info_size, sizeof(info));
+        close(ebc_fd);
+        ebc_fd = -1;
+        return false;
+    }
+
+    /* These are the request dimensions used by ONYX ttyscreen. */
+    info.words[6] = 1872;
+    info.words[7] = 1404;
+    if (ioctl(ebc_fd, ONYX_EBC_GET_BUFFER_INFO, &info) < 0) {
+        perror("ONYX EBC: GET_BUFFER_INFO failed");
+        close(ebc_fd);
+        ebc_fd = -1;
+        return false;
+    }
+
+    uint32_t ebc_width = info.words[6];
+    uint32_t ebc_height = info.words[7];
+    if (ebc_width != width || ebc_height != height) {
+        printf("ONYX EBC: buffer is %ux%u, DRM mode is %ux%u\n",
+               ebc_width, ebc_height, width, height);
+        close(ebc_fd);
+        ebc_fd = -1;
+        return false;
+    }
+
+    ebc_buffer_size = (size_t)width * height * 4;
+    ebc_buffer = static_cast<uint8_t*>(mmap(nullptr, ebc_buffer_size,
+                                             PROT_READ | PROT_WRITE,
+                                             MAP_SHARED, ebc_fd, 0));
+    if (ebc_buffer == MAP_FAILED) {
+        perror("ONYX EBC: mmap failed");
+        ebc_buffer = nullptr;
+        close(ebc_fd);
+        ebc_fd = -1;
+        return false;
+    }
+
+    printf("ONYX EBC: mapped %ux%u update buffer\n", width, height);
+    return true;
+}
+
+static int onyx_ebc_flip(const GRSurface* surface) {
+    if (ebc_fd < 0 || !ebc_buffer)
+        return -ENODEV;
+
+    const size_t packed_row_bytes = (size_t)surface->width * 4;
+    for (uint32_t y = 0; y < surface->height; ++y) {
+        memcpy(ebc_buffer + y * packed_row_bytes,
+               surface->data + y * surface->row_bytes,
+               packed_row_bytes);
+    }
+
+    struct onyx_ebc_update update = {};
+    update.width = surface->width;
+    update.height = surface->height;
+    update.waveform_mode = 5;
+    update.update_mode = 1;
+    update.update_marker = update_marker++;
+    update.temperature = ONYX_EBC_AUTO_TEMP;
+    update.flags = ONYX_EBC_DITHER_FLAG;
+
+    int ret = ioctl(ebc_fd, ONYX_EBC_SEND_UPDATE, &update);
+    if (ret < 0)
+        perror("ONYX EBC: SEND_UPDATE failed");
+    return ret;
+}
